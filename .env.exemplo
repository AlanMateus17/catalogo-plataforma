# Copie para .env e preencha. NUNCA suba o .env para o GitHub (ele já está no .gitignore).

# ---- Domínio (sem https://) ----
DOMINIO=seusite.com.br
Site__UrlPublica=https://seusite.com.br
Site__Nome=Catalogo do HTML

# ---- Banco ----
BANCO_NOME=plataforma
BANCO_USUARIO=plataforma
BANCO_SENHA=troque-por-uma-senha-longa-e-aleatoria

# ---- Primeiro administrador: crie a conta com este e-mail e confirme ----
Plataforma__AdminInicial=seu-email@exemplo.com

# ---- E-mail (SMTP). Sem isso, ninguém recebe confirmação nem troca de senha ----
Email__Remetente=nao-responda@seusite.com.br
Email__NomeRemetente=Catálogo do HTML
Email__Smtp__Servidor=smtp-relay.brevo.com
Email__Smtp__Porta=587
Email__Smtp__Usuario=
Email__Smtp__Senha=

# ---- Plataformas de venda (deixe vazio a que você não usar) ----
Vendas__Kiwify__Token=
Vendas__Hotmart__Hottok=
Vendas__MercadoPago__AccessToken=
Vendas__MercadoPago__SegredoWebhook=

# ---- Segurança ----
Seguranca__Exigir2faEquipe=true
